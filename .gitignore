/target
**/*.rs.bk

# Anything baked from, or belonging to, the original game. This project ships an
# engine, never assets. Everything below is generated locally from a copy of the
# game that the person running it already owns.
/packs/reference/
/reference/
*.adf
*.exe
*.unpacked.bin
*.cel
*.CEL
*.ob
*.OB
*.piv
*.PIV
*.cmp
*.CMP
*.fon
*.FON
*.hit
*.HIT
*.voc

# A saved game, which a player's run makes wherever they run the game from,
# and the control bindings, which are written beside it.
/henge-save.json
/henge-controls.json

# Python bytecode from the research tools
__pycache__/
*.pyc
/research/
privateGithub
privateGithub.pub
